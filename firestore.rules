rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // usersコレクション: 権限情報を保護する。
    // - 読み取り: ログイン済みなら誰でも可（自分や他スタッフの権限確認に必要）
    // - 書き込み: クライアントからは一切不可。作成・ロール変更・有効/無効切替は
    //   すべて Cloud Functions（管理者チェック済み・Admin SDK経由）でのみ行う。
    // 注意: Firestoreルールは複数matchブロックがOR結合されるため、
    // 下記の他コレクション用ワイルドカードにusersを含めないよう明示的に列挙している。
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 予約・清掃報告: ログイン必須（未ログインの第三者がFirestore APIへ直接アクセスするのを防ぐ）。
    // ロールごとの細かい書き込み制限（例:顧客は自分のフィードバック欄しか書けない）は
    // 未実装。現状は「ログインしていれば読み書き可」という粒度に留まる。
    match /reservations/{docId} {
      allow read, write: if request.auth != null;
    }

    // その他のコレクションは開発フェーズのため引き続きオープン。
    // 今後の課題として認証必須化を検討。
    match /sheetConfigs/{docId} {
      allow read, write: if true;
    }
    match /lineConfigs/{docId} {
      allow read, write: if true;
    }

    // 協力業者マスタ・物件担当割り当て: 読み取りはログイン済みなら誰でも可
    // （協力業者アカウントが自分の担当物件を判定するために必要）。
    // 書き込みは管理者のみ（usersコレクションのroleを参照して判定）。
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 協力業者マスタ: 銀行口座番号など機微な情報を含むため、物件マスタ同様に管理者限定。
    // スタッフ・協力業者が必要とする「担当業者の色分け」等の情報を含まないため、
    // 一般ロールからの読み取りは不要（実際に onVendorsChange を使うのは
    // AccountManagement.jsx / VendorManagement.jsx の管理者専用画面のみ）。
    match /vendors/{vendorId} {
      allow read, write: if isAdmin();
    }
    match /propertyAssignments/{propertyId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // マスタデータ（顧客・物件・従業員）: 読み取りはログイン済みなら誰でも可。
    // 書き込みは管理者のみ（物件マスタ取り込みスクリプトはAdmin SDK経由なのでルール対象外）。
    match /customers/{customerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // 物件マスタ: 住所・清掃単価・マネージャー連絡先など機微な情報を含むため、
    // 管理者以外（スタッフ・協力業者・顧客アカウント含む）は読み書きともに不可。
    // 顧客ポータル（清掃報告閲覧）は物件マスタを直接読まず、Cloud Function経由で
    // 必要最小限のデータのみ取得する（functions/customerReports.js）。
    match /properties/{propertyName} {
      allow read, write: if isAdmin();
    }
    // 物件ディレクトリ: 物件マスタから「物件名→顧客名」だけを抜き出した、機微情報を含まない軽量コピー。
    // 清掃管理画面で「桜」「櫻」のような同名・紛らわしい物件名を顧客名付きで区別できるよう、
    // スタッフ・協力業者も含めて読み取り可能にする（住所・単価等は properties 側のみで管理者限定）。
    // 書き込みは importMasterData.js / 管理者操作からのみ（Admin SDK経由か管理者のみ許可）。
    match /propertyDirectory/{propertyName} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // 従業員マスタ: 銀行口座番号など機微な情報を含むため、協力業者マスタ同様に管理者限定。
    // スタッフ本人が自分の情報を見る用途は現状なく、実際に読むのは
    // AccountManagement.jsx（アカウント作成時の紐付け選択）等の管理者専用画面のみ。
    match /employees/{employeeId} {
      allow read, write: if isAdmin();
    }
  }
}
