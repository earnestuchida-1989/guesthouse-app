rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 清掃完了報告の写真: ログイン済みユーザーなら読み書き可能
    // （詳細な閲覧範囲はFirestore側の顧客・業者フィルタで制御する。
    //   写真自体のURLはFirestoreドキュメント経由でのみ参照される想定）
    match /reservations/{reservationId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
